:root{
  --bg:#1c1e21;          /* 冷灰底 */
  --panel:rgba(40,43,48,.72); /* 毛玻璃面板 */
  --line:rgba(255,255,255,.12);
  --text:#d7dadf;
  --muted:#8b9199;
  --accent:#e8e100;       /* 柠檬黄 */
  --accent-dim:#a7a300;
  --radius:14px;
  --clip:polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,14px 100%,0 calc(100% - 14px));
}

body{background:var(--bg);color:var(--text);
  font-family:"Rajdhani","Share Tech Mono",-apple-system,"Segoe UI",sans-serif;}

/* 导航条变成终端顶栏 */
header{
  background:linear-gradient(180deg,rgba(0,0,0,.35),transparent);
  border-bottom:1px solid var(--line);
}
nav a{
  color:var(--muted);border:1px solid transparent;border-radius:0;
  clip-path:var(--clip);padding:8px 18px;
}
nav a.active{color:#111;background:var(--accent);font-weight:700;}
nav a:hover{border-color:var(--accent);color:var(--accent);}

/* 卡片=悬浮工业面板 */
.card,.intro-card,.quick-card,.proj-card{
  background:var(--panel);
  backdrop-filter:blur(8px);
  border:1px solid var(--line);
  clip-path:var(--clip);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 6px 20px rgba(0,0,0,.35);
}
.quick-card.plog{border-top:3px solid var(--accent);}
.quick-card.code{border-top:3px solid #4a90d9;}
.quick-card.msg{border-top:3px solid #e8806a;}

/* 按钮按压回弹 */
button{background:var(--accent);color:#111;border:none;
  clip-path:var(--clip);transition:transform .08s ease,filter .2s;}
button:hover{filter:brightness(1.08);}
button:active{transform:translateY(2px) scale(.98);}

/* 进度条=能量槽 */
.bar{background:rgba(255,255,255,.08);height:8px;border-radius:0;}
.fill{background:linear-gradient(90deg,var(--accent-dim),var(--accent));
  box-shadow:0 0 8px var(--accent);}

/* 标题前加几何标号 */
.date-group h2::before{content:"▷ ";color:var(--accent);}
